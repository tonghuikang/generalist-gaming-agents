 var g = ga(w, w, setup)
 g.start()
 
+// Fixed-seed course (not upstream): the squares' sizes and positions come from their own
+// seeded generator (mulberry32), reset at the start of every attempt, so each attempt meets
+// the same course. Particles and sounds keep using Math.random.
+const COURSE_SEED = 13
+var courseState = COURSE_SEED
+
+function courseRandom() {
+  courseState = (courseState + 0x6D2B79F5) | 0
+  var t = Math.imul(courseState ^ (courseState >>> 15), 1 | courseState)
+  t = (t + Math.imul(t ^ (t >>> 7), 61 | t)) ^ t
+  return ((t ^ (t >>> 14)) >>> 0) / 4294967296
+}
+
+// Same contract as Ga's g.randomInt: an integer from min to max inclusive
+function courseInt(min, max) {
+  return Math.floor(courseRandom() * (max - min + 1)) + min
+}
